{
  "$schema": "https://raw.githubusercontent.com/denoland/deno/main/cli/schemas/config-file.v1.json",
  "fmt": {
    "lineWidth": 120,
    "include": ["datastores", "functions", "lib", "manifest.ts", "scripts", "tests", "triggers", "workflows"]
  },
  "lint": {
    "include": ["datastores", "functions", "lib", "manifest.ts", "scripts", "tests", "triggers", "workflows"]
  },
  "lock": false,
  "tasks": {
    "test": "deno test tests/",
    "dry-run": "deno run --allow-net=www.randonneursontario.ca scripts/dry_run.ts"
  },
  "imports": {
    "deno-slack-sdk/": "https://deno.land/x/deno_slack_sdk@2.15.1/",
    "deno-slack-api/": "https://deno.land/x/deno_slack_api@2.8.0/"
  }
}
